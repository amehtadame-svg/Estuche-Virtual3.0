cat > .env-example <<'EOF'
# Variables de la RAÍZ del repo (junto a docker-compose.yml).
#
# Opción A — PC / servidor del local:
#   copia este archivo a ".env" y rellena los valores. El .env está en
#   .gitignore, nunca se sube al repo.
#
# Opción B — Codespaces (recomendada, cero pasos manuales):
#   NO hace falta este archivo. Crea los mismos nombres como Codespaces
#   secrets y Compose los usa automáticamente al hacer
#   "docker compose up --build".

# ── Base principal: Supabase ─────────────────────────────────────────────
# Supabase Dashboard → Connect → ORM Third-party library → Prisma
# → método Session pooler (host *.pooler.supabase.com, puerto 5432).
SUPABASE_DATABASE_URL=postgresql://postgres.TU_REF:TU_PASSWORD@TU_HOST_POOLER:5432/postgres

# ── Base local de respaldo (fase offline) ────────────────────────────────
# Opcional: si no se define, se usa el servicio "db" de Compose.
#LOCAL_DATABASE_URL=postgresql://estuche_user:estuche_pass@db:5432/estuche_virtual

# ── JWT ──────────────────────────────────────────────────────────────────
# Genera uno con:  openssl rand -base64 32   (32 caracteres o más)
JWT_SECRET=

# ── Correo (opcional en desarrollo) ──────────────────────────────────────
# Sin valores, el backend usa la cuenta de prueba Ethereal y el enlace del
# código de recuperación aparece en los logs.
#EMAIL_USER=
#EMAIL_PASS=
EOF
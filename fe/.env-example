# URL base del backend (API). Copia este archivo a .env y ajusta el valor.
#
# Prioridad de resolución (C-07):
#   1. VITE_API_URL  -> apunta al backend que indiques aquí (Docker/producción)
#   2. Codespaces    -> se detecta automáticamente
#   3. localhost:4000-> desarrollo local por defecto
#
# En Docker Compose el backend se alcanza como http://backend:4000 dentro de la
# red; en producción, https://api.midominio.com
VITE_API_URL=http://localhost:4000

# Destino del proxy de Vite (rutas /api). Se resuelve DENTRO del contenedor,
# donde el backend no es "localhost" sino el nombre del servicio de Compose.
#   local:            http://localhost:4000 (valor por defecto)
#   docker compose:   http://backend:4000
VITE_PROXY_TARGET=http://localhost:4000
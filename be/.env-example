cat > be/.env-example <<'EOF'
# Copia este archivo a be/.env si vas a correr el backend NATIVO (pnpm dev),
# fuera de Docker. Con Docker Compose estas variables se inyectan desde el
# .env de la raíz del repo (o desde los Codespaces secrets), así que este
# archivo no hace falta.

DATABASE_URL=postgresql://usuario:password@host:5432/base
JWT_SECRET=cambia-esto-por-un-secreto-de-32-o-mas-caracteres
PORT=4000

# Lista blanca de CORS, separada por comas. Nunca usar "*".
CORS_ORIGINS=http://localhost:5173,https://*.app.github.dev

# Credenciales de correo (opcionales en desarrollo).
#
# Si se dejan SIN valor, el backend usa una cuenta de prueba (Ethereal): el
# correo no llega a una bandeja real, pero los logs muestran un enlace para
# verlo. Así el flujo de recuperación de contraseña nunca queda roto.
#
# Para Gmail real:
#   1) activa la Verificación en 2 pasos en la cuenta
#   2) genera una "Contraseña de aplicación" (16 caracteres) en
#      https://myaccount.google.com/apppasswords
#   3) descomenta y rellena las dos líneas
#EMAIL_USER=tu-correo@gmail.com
#EMAIL_PASS=contraseña-de-aplicacion-de-16-caracteres
EOF
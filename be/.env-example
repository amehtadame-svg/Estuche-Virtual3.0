# Copia este archivo a be/.env si vas a correr el backend NATIVO (pnpm dev),
# fuera de Docker. Con Docker Compose estas variables se inyectan desde el
# .env de la raíz del repo (o desde los Codespaces secrets), así que este
# archivo no hace falta.

# ── Base de datos (obligatoria) ──────────────────────────────────────────
# Prisma exige una URL postgresql://. En local puedes usar el servicio "db"
# del docker-compose de la raíz o una base propia.
DATABASE_URL=postgresql://usuario:password@host:5432/base

# ── Seguridad (obligatoria) ──────────────────────────────────────────────
# Genera uno con:  openssl rand -base64 32   (32 caracteres o más)
JWT_SECRET=cambia-esto-por-un-secreto-de-32-o-mas-caracteres

# ── Servidor ─────────────────────────────────────────────────────────────
PORT=4000

# Lista blanca de CORS, separada por comas. Nunca usar "*".
# Si accedes desde otra máquina del equipo, añade su origen
# (p. ej. http://192.168.1.20:5173).
CORS_ORIGINS=http://localhost:5173,https://*.app.github.dev

# ── Límite de peticiones (opcional) ──────────────────────────────────────
# Se aplica al bloque /api/auth. Valores por defecto: 10 intentos / 15 min.
#RATE_LIMIT_MAX=10
#RATE_LIMIT_WINDOW_MS=900000

# ── Reservas de empleados (opcional) ─────────────────────────────────────
# Minutos antes de que una reserva pendiente venca y libere stock.
#EMPLOYEE_RESERVATION_MINUTES=30
# Minutos entre ejecuciones del job automático de vencimiento (0 = apagado).
#RESERVATION_EXPIRY_INTERVAL_MINUTES=5

# ── Recuperación de contraseña (opcional) ────────────────────────────────
#RESET_TOKEN_MINUTES=15
#LOGIN_MAX_ATTEMPTS=5
#LOGIN_LOCK_MINUTES=15

# ── Correo (opcional en desarrollo) ──────────────────────────────────────
#
# Si se dejan SIN valor, el backend usa una cuenta de prueba (Ethereal): el
# correo no llega a una bandeja real, pero los logs muestran un enlace para
# verlo. Así el flujo de recuperación de contraseña nunca queda roto.
#
# Para Gmail real:
#   1) activa la Verificación en 2 pasos en la cuenta
#   2) genera una "Contraseña de aplicación" (16 caracteres) en
#      https://myaccount.google.com/apppasswords
#   3) descomenta y rellena las dos líneas
#EMAIL_USER=tu-correo@gmail.com
#EMAIL_PASS=contraseña-de-aplicacion-de-16-caracteres
#EMAIL_FROM_NAME=Estuche Virtual
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465
#SMTP_SECURE=true

# ── Seed (solo desarrollo) ───────────────────────────────────────────────
# El seed está bloqueado contra Supabase para no tocar la base principal.
# ALLOW_SEED_SUPABASE=1   # solo si quieres forzarlo a conciencia

# Pagos académicos: habilitar solo en una base de demostración.
# No hay integración bancaria ni cobros reales. Bloqueado en producción.
NODE_ENV=development
ENABLE_PAYMENT_SIMULATION=false

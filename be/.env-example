# Copia este archivo a `.env` y ajusta los valores.

# ── Base de datos ────────────────────────────────────────────────────────────
# Desarrollo local (sin Docker):
DATABASE_URL=postgresql://estuche_user:estuche_pass@localhost:5432/estuche_virtual
# Con Docker Compose el host es el nombre del servicio:
# DATABASE_URL=postgresql://estuche_user:estuche_pass@db:5432/estuche_virtual

# ── Seguridad ────────────────────────────────────────────────────────────────
# Secreto para firmar y verificar los JWT (mínimo 32 caracteres).
JWT_SECRET="cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres"

PORT=4000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Lista blanca de orígenes separados por coma. Nunca uses "*" en producción.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://*.app.github.dev,https://*.e2b.app

# ── Rate limiting de /api/auth ───────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ── Seed ─────────────────────────────────────────────────────────────────────
# RUN_SEED=false omite el seed al arrancar el contenedor.
RUN_SEED=true
# SEED_FORCE=true vuelve a escribir roles y contraseñas de cuentas existentes.
SEED_FORCE=false

# ── Correo (recuperación de contraseña) ──────────────────────────────────────
EMAIL_USER=correo registrado
EMAIL_PASS=contraseña correo

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=4000

# ── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://estuche_user:estuche_pass@localhost:5432/estuche_virtual

# ── Autenticación ───────────────────────────────────────────────────────────
# Secreto de firma de los JWT. Mínimo 32 caracteres aleatorios.
# Debe ser la MISMA variable para firma y verificación (C-04).
JWT_SECRET=your-super-secret-access-key-min-32-chars-change-in-production

# ── CORS (C-06 / RNF-001.4) ─────────────────────────────────────────────────
# Orígenes permitidos, separados por coma. Nunca un comodín global.
# Se admite '*' solo en el subdominio (p. ej. https://*.app.github.dev)
# para entornos de preview como Codespaces.
CORS_ORIGINS=http://localhost:5173,https://*.app.github.dev

# ── Rate limiting en /api/auth (C-06 / RNF-001.3) ──────────────────────────
# Máximo de peticiones por ventana de tiempo, por IP.
RATE_LIMIT_MAX=10
# Ventana en milisegundos. 900000 = 15 minutos.
RATE_LIMIT_WINDOW_MS=900000

# ── Correo (recuperación de contraseña) ─────────────────────────────────────
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASS=tu-contrasena-de-aplicacion

# ── Bloqueo por intentos de login fallidos ──────────────────────────────────
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCK_MINUTES=15

# ── Código de recuperación de contraseña ────────────────────────────────────
RESET_TOKEN_MINUTES=15

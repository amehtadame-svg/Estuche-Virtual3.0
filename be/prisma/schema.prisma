generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  client
  employee
  delivery
  admin
  superadmin
}

enum OrderStatus {
  pending
  paid
  preparing
  shipped
  delivered
  canceled
  returned
}

enum PaymentStatus {
  pending
  approved
  rejected
  refunded
}

enum ReceiptStatus {
  pending
  paid
  partial
  overdue
  voided
}

enum DespatchStatus {
  in_transit
  delivered
  returned
  canceled
}

enum ReturnStatus {
  requested
  approved
  rejected
  refunded
}

enum MovementType {
  in
  out
  adjustment
}

enum PromotionalCodeType {
  percentage
  fixed
}

model User {
  id                 String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email              String   @unique @db.VarChar(255)
  fullName           String   @db.VarChar(150) @map("full_name")
  hashedPassword     String   @db.VarChar(255) @map("hashed_password")
  passwordUpdatedAt  DateTime? @default(now()) @map("password_updated_at")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  phone              String?  @db.VarChar(30)
  address            String?  @db.VarChar(255)
  role               Role     @default(client)
  isActive           Boolean  @default(true) @map("is_active")
  isEmailVerified    Boolean  @default(false) @map("is_email_verified")
  mfaEnabled         Boolean  @default(false) @map("mfa_enabled")
  mfaSecret          String?  @db.VarChar(255) @map("mfa_secret")
  failedAttempts     Int      @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until")
  lastLogin          DateTime? @map("last_login")
  dataConsentAt      DateTime? @map("data_consent_at")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @map("updated_at")

  shopping          Shopping[]
  returns           OrderReturn[]
  deliveryAddresses DeliveryAddress[]
  shipments         Despatch[]
  receipts          Receipt[]
  receiptsAsEmployee Receipt[] @relation("ReceiptEmployee")
  priceHistory      PriceHistory[]
  wishlist          Wishlist[]
  inventoryMovements InventoryMovement[]
  notifications     Notification[]
  payouts           Payout[]
  ordersAsCustomer  Order[] @relation("OrderCustomer")
  ordersAsDriver    Order[] @relation("OrderDriver")
  reviews           Review[]
  securityEvents    SecurityEvent[]

  @@index([lockedUntil], map: "idx_users_locked_until")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

model Order {
  id               String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  customerId       String?     @db.Uuid @map("customer_id")
  driverId         String?     @db.Uuid @map("driver_id")
  promotionalCodeId String?    @db.Uuid @map("promotional_code_id")
  deliveryAddressId String?    @db.Uuid @map("delivery_address_id")
  orderDate        DateTime?   @default(now()) @map("order_date")
  status           OrderStatus @default(pending)
  total            Decimal     @default(0) @db.Decimal(14, 2)
  updatedAt        DateTime?   @default(now()) @map("updated_at")

  details          OrderDetail[]
  returns          OrderReturn[]
  shipments        Despatch[]
  receipt          Receipt?
  customer         User?           @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promotionalCode  PromotionalCode? @relation(fields: [promotionalCodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deliveryAddress  DeliveryAddress? @relation(fields: [deliveryAddressId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driver           User?           @relation("OrderDriver", fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customerId], map: "idx_orders_customer")
  @@index([driverId], map: "idx_orders_driver")
  @@map("orders")
}

model Product {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  price       Decimal  @db.Decimal(14, 2)
  stock       Int      @default(0)
  stockMin    Int      @default(5) @map("stock_min")
  categoryId  String?  @db.Uuid @map("category_id")
  supplierId  String?  @db.Uuid @map("supplier_id")
  createdAt   DateTime @default(now()) @map("created_at")

  shopping           Shopping[]
  receiptItems       ReceiptItem[]
  details            OrderDetail[]
  returns            OrderReturn[]
  priceHistory       PriceHistory[]
  images             ProductImage[]
  wishlist           Wishlist[]
  inventoryMovements InventoryMovement[]
  category           Category?  @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier           Provider?  @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviews            Review[]

  @@index([categoryId], map: "idx_products_category")
  @@index([supplierId], map: "idx_products_supplier")
  @@map("products")
}

model Category {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  products    Product[]
  providerCategories ProviderCategory[]

  @@map("categories")
}

model Provider {
  id       String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name     String  @db.VarChar(150)
  phone    String? @db.VarChar(30)
  email    String? @db.VarChar(255)
  address  String? @db.VarChar(255)
  products Product[]
  providerCategories ProviderCategory[]

  @@map("providers")
}

model OrderDetail {
  id        String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId   String  @db.Uuid @map("order_id")
  productId String  @db.Uuid @map("product_id")
  quantity  Int
  unitPrice Decimal @db.Decimal(14, 2) @map("unit_price")
  subtotal  Decimal? @db.Decimal(14, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId], map: "idx_order_details_order")
  @@map("order_details")
}

model Despatch {
  id          String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId     String          @db.Uuid @map("order_id")
  shipDate    DateTime?       @default(now()) @map("ship_date")
  deliveredAt DateTime?       @map("delivered_at")
  status      DespatchStatus  @default(in_transit)
  driverId    String?         @db.Uuid @map("driver_id")
  address     String?         @db.VarChar(255)

  order   Order @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driver  User? @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId], map: "idx_despatches_order")
  @@map("despatches")
}

model InventoryMovement {
  id        String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId String        @db.Uuid @map("product_id")
  type      MovementType
  quantity  Int
  reason    String?       @db.VarChar(500)
  userId    String?       @db.Uuid @map("user_id")
  date      DateTime?     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User?   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([productId], map: "idx_inventory_movements_product")
  @@map("inventory_movements")
}

model Receipt {
  id             String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  receiptNumber  Int           @unique @default(autoincrement()) @map("receipt_number")
  customerId     String?       @db.Uuid @map("customer_id")
  employeeId     String?       @db.Uuid @map("employee_id")
  orderId        String?       @unique @db.Uuid @map("order_id")
  date           DateTime?     @default(now())
  total          Decimal       @default(0) @db.Decimal(14, 2)
  paymentStatus  ReceiptStatus @default(pending) @map("payment_status")

  receiptItems ReceiptItem[]
  customer     User?  @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee     User?  @relation("ReceiptEmployee", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order        Order? @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payouts      Payout[]

  @@index([customerId], map: "idx_receipts_customer")
  @@index([employeeId], map: "idx_receipts_employee")
  @@index([orderId], map: "idx_receipts_order")
  @@map("receipts")
}

model Shopping {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  productId String   @db.Uuid @map("product_id")
  quantity  Int
  addedAt   DateTime? @default(now()) @map("added_at")

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, productId], map: "shopping_user_product_unique")
  @@index([userId], map: "idx_shopping_user")
  @@map("shopping")
}

model PromotionalCode {
  id           String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code         String              @unique @db.VarChar(50)
  description  String?             @db.VarChar(500)
  type         PromotionalCodeType
  value        Decimal             @db.Decimal(14, 2)
  minPurchase  Decimal?            @default(0) @db.Decimal(14, 2) @map("min_purchase")
  startDate    DateTime            @db.Date @map("start_date")
  endDate      DateTime            @db.Date @map("end_date")
  maxUses      Int?                @map("max_uses")
  currentUses  Int?                @default(0) @map("current_uses")
  active       Boolean?            @default(true)
  version      Int                 @default(0)
  orders       Order[]

  @@map("promotional_codes")
}

model ReceiptItem {
  id        String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  receiptId String  @db.Uuid @map("receipt_id")
  productId String  @db.Uuid @map("product_id")
  quantity  Int
  unitPrice Decimal @db.Decimal(14, 2) @map("unit_price")
  subtotal  Decimal? @db.Decimal(14, 2)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([receiptId], map: "idx_receipt_items_receipt")
  @@map("receipt_items")
}

model OrderReturn {
  id              String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId         String       @db.Uuid @map("order_id")
  customerId      String       @db.Uuid @map("customer_id")
  productId       String       @db.Uuid @map("product_id")
  quantity        Int
  reason          String       @db.VarChar(500)
  status          ReturnStatus @default(requested)
  productCondition String      @default("good") @db.VarChar(30) @map("product_condition")
  refund          Decimal?     @default(0) @db.Decimal(14, 2)
  requestedAt     DateTime?    @default(now()) @map("requested_at")
  resolvedAt      DateTime?    @map("resolved_at")
  updatedAt       DateTime?    @default(now()) @map("updated_at")

  customer User    @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order    Order   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product  Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId], map: "idx_returns_order")
  @@map("returns")
}

model DeliveryAddress {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId       String   @db.Uuid @map("user_id")
  contactName  String?  @db.VarChar(150) @map("contact_name")
  phone        String?  @db.VarChar(30)
  address      String   @db.VarChar(255)
  city         String?  @db.VarChar(150)
  state        String?  @db.VarChar(150)
  isPrimary    Boolean? @default(false) @map("is_primary")

  user   User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders Order[]

  @@index([userId], map: "idx_delivery_addresses_user")
  @@map("delivery_addresses")
}

model PriceHistory {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId     String   @db.Uuid @map("product_id")
  previousPrice Decimal  @db.Decimal(14, 2) @map("previous_price")
  newPrice      Decimal  @db.Decimal(14, 2) @map("new_price")
  changedAt     DateTime? @default(now()) @map("changed_at")
  userId        String?  @db.Uuid @map("user_id")

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User?   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([productId], map: "idx_price_history_product")
  @@map("price_history")
}

model ProductImage {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId String   @db.Uuid @map("product_id")
  url       String   @db.VarChar(500)
  name      String?  @db.VarChar(150)
  isPrimary Boolean? @default(false) @map("is_primary")
  sortOrder Int?     @default(1) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([productId], map: "idx_product_images_product")
  @@map("product_images")
}

model Wishlist {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String    @db.Uuid @map("user_id")
  productId String    @db.Uuid @map("product_id")
  addedAt   DateTime? @default(now()) @map("added_at")

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, productId], map: "wishlist_user_product_unique")
  @@index([userId], map: "idx_wishlist_user")
  @@map("wishlist")
}

model Notification {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String    @db.Uuid @map("user_id")
  title     String    @db.VarChar(150)
  message   String    @db.VarChar(500)
  type      String    @db.VarChar(50)
  isRead    Boolean?  @default(false) @map("is_read")
  date      DateTime? @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "idx_notifications_user")
  @@map("notifications")
}

model Payout {
  id              String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  receiptId       String        @db.Uuid @map("receipt_id")
  userId          String        @db.Uuid @map("user_id")
  gateway         String        @db.VarChar(50)
  transactionId   String        @unique @db.VarChar(255) @map("transaction_id")
  status          PaymentStatus @default(pending)
  method          String?       @db.VarChar(50)
  amount          Decimal       @db.Decimal(14, 2)
  currency        String        @default("COP") @db.VarChar(10)
  paidAt          DateTime?     @default(now()) @map("paid_at")
  confirmedAt     DateTime?     @map("confirmed_at")
  gatewayToken    String?       @db.VarChar(255) @map("gateway_token")

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([receiptId], map: "idx_payouts_receipt")
  @@index([userId], map: "idx_payouts_user")
  @@map("payouts")
}

model Report {
  id               String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  date             DateTime @unique @db.Date
  totalOrders      Int      @default(0) @map("total_orders")
  deliveredOrders  Int      @default(0) @map("delivered_orders")
  canceledOrders   Int      @default(0) @map("canceled_orders")
  totalSold        Decimal  @default(0) @db.Decimal(14, 2) @map("total_sold")
  totalPaid        Decimal  @default(0) @db.Decimal(14, 2) @map("total_paid")
  totalRefunded    Decimal  @default(0) @db.Decimal(14, 2) @map("total_refunded")
  productsSold     Int      @default(0) @map("products_sold")
  newCustomers     Int      @default(0) @map("new_customers")
  generatedAt      DateTime? @default(now()) @map("generated_at")

  @@index([date], map: "idx_reports_date")
  @@map("reports")
}

model Review {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId String    @db.Uuid @map("product_id")
  userId    String    @db.Uuid @map("user_id")
  rating    Int
  comment   String?   @db.VarChar(1000)
  date      DateTime? @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([productId, userId], map: "review_product_user_unique")
  @@index([productId], map: "idx_reviews_product")
  @@map("reviews")
}

model ProviderCategory {
  providerId String   @db.Uuid @map("provider_id")
  categoryId String   @db.Uuid @map("category_id")

  category Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([providerId, categoryId], name: "provider_category_pkey")
  @@map("provider_categories")
}

model SecurityEvent {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String?  @db.Uuid @map("user_id")
  type      String   @db.VarChar(50)
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(255) @map("user_agent")
  detail    Json?
  success   Boolean  @default(true)
  date      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "idx_security_events_user")
  @@index([type, date], map: "idx_security_events_type_date")
  @@index([ip, date], map: "idx_security_events_ip_date")
  @@map("security_events")
}

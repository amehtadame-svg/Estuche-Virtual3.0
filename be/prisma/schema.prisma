generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  client
  employee
  delivery
  admin
  superadmin
}

enum FulfillmentMethod {
  delivery
  pickup
}

enum WorkStatus {
  picking
  packed
  blocked
  dispatched
  completed
}

enum OrderStatus {
  pending
  paid
  preparing
  shipped
  delivered
  canceled
  returned
}

enum PaymentStatus {
  pending
  approved
  rejected
  refunded
}

enum ReceiptStatus {
  pending
  paid
  partial
  overdue
  voided
}

enum DespatchStatus {
  in_transit
  delivered
  returned
  canceled
}

enum ReturnStatus {
  requested
  approved
  rejected
  refunded
}

enum PqrType {
  petition
  complaint
  claim
}

enum PqrStatus {
  received
  in_progress
  answered
  closed
}

enum MovementType {
  in
  out
  adjustment
}

enum PromotionalCodeType {
  percentage
  fixed
}

model User {
  id                 String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email              String    @unique @db.VarChar(255)
  fullName           String    @map("full_name") @db.VarChar(150)
  hashedPassword     String    @map("hashed_password") @db.VarChar(255)
  passwordUpdatedAt  DateTime? @default(now()) @map("password_updated_at")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  phone              String?   @db.VarChar(30)
  address            String?   @db.VarChar(255)
  role               Role      @default(client)
  isActive           Boolean   @default(true) @map("is_active")
  isEmailVerified    Boolean   @default(false) @map("is_email_verified")
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  mfaSecret          String?   @map("mfa_secret") @db.VarChar(255)
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until")
  lastLogin          DateTime? @map("last_login")
  dataConsentAt      DateTime? @map("data_consent_at")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @map("updated_at")

  ordersCreated      Order[]             @relation("OrderCreator")
  assignedWork       OrderWork[]         @relation("WorkAssignee")
  operationalEvents  OrderEvent[]
  shopping           Shopping[]
  returns            OrderReturn[]
  deliveryAddresses  DeliveryAddress[]
  shipments          Despatch[]
  receipts           Receipt[]
  receiptsAsEmployee Receipt[]           @relation("ReceiptEmployee")
  priceHistory       PriceHistory[]
  wishlist           Wishlist[]
  inventoryMovements InventoryMovement[]
  notifications      Notification[]
  payouts            Payout[]
  ordersAsCustomer   Order[]             @relation("OrderCustomer")
  ordersAsDriver     Order[]             @relation("OrderDriver")
  reviews            Review[]
  securityEvents     SecurityEvent[]
  combosCreated      Combo[]
  pqrRequests        PqrRequest[]        @relation("PqrCustomer")
  pqrResponses       PqrRequest[]        @relation("PqrResponder")

  @@index([lockedUntil], map: "idx_users_locked_until")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

model Order {
  id                String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  customerId        String?     @map("customer_id") @db.Uuid
  driverId          String?     @map("driver_id") @db.Uuid
  promotionalCodeId String?     @map("promotional_code_id") @db.Uuid
  deliveryAddressId String?     @map("delivery_address_id") @db.Uuid
  orderDate         DateTime?   @default(now()) @map("order_date")
  status            OrderStatus @default(pending)
  total             Decimal     @default(0) @db.Decimal(14, 2)
  updatedAt         DateTime?   @default(now()) @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")

  createdById       String?           @map("created_by_id") @db.Uuid
  requestKey        String?           @unique @map("request_key") @db.Uuid
  requestHash       String?           @map("request_hash") @db.VarChar(64)
  fulfillmentMethod FulfillmentMethod @default(delivery) @map("fulfillment_method")
  deliverySnapshot  String?           @map("delivery_snapshot") @db.VarChar(500)
  expiresAt         DateTime?         @map("expires_at")
  stockReleasedAt   DateTime?         @map("stock_released_at")
  creator           User?             @relation("OrderCreator", fields: [createdById], references: [id], onDelete: NoAction)
  work              OrderWork?
  events            OrderEvent[]

  details         OrderDetail[]
  returns         OrderReturn[]
  shipments       Despatch[]
  receipt         Receipt?
  customer        User?            @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promotionalCode PromotionalCode? @relation(fields: [promotionalCodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deliveryAddress DeliveryAddress? @relation(fields: [deliveryAddressId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driver          User?            @relation("OrderDriver", fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdById, orderDate])
  @@index([expiresAt, status])
  @@index([customerId], map: "idx_orders_customer")
  @@index([driverId], map: "idx_orders_driver")
  @@index([deletedAt], map: "idx_orders_deleted_at")
  @@map("orders")
}

model Product {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  sku         String?   @unique @db.VarChar(80)
  barcode     String?   @unique @db.VarChar(80)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  cost        Decimal   @default(0) @db.Decimal(14, 2)
  price       Decimal   @db.Decimal(14, 2)
  stock       Int       @default(0)
  stockMin    Int       @default(5) @map("stock_min")
  categoryId  String?   @map("category_id") @db.Uuid
  supplierId  String?   @map("supplier_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  shopping           Shopping[]
  receiptItems       ReceiptItem[]
  details            OrderDetail[]
  returns            OrderReturn[]
  priceHistory       PriceHistory[]
  images             ProductImage[]
  wishlist           Wishlist[]
  inventoryMovements InventoryMovement[]
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier           Provider?           @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviews            Review[]
  comboItems         ComboItem[]

  @@index([categoryId], map: "idx_products_category")
  @@index([supplierId], map: "idx_products_supplier")
  @@index([deletedAt], map: "idx_products_deleted_at")
  @@map("products")
}

model Category {
  id                 String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name               String             @db.VarChar(150)
  description        String?            @db.VarChar(500)
  products           Product[]
  providerCategories ProviderCategory[]

  @@map("categories")
}

model Provider {
  id                 String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name               String             @db.VarChar(150)
  phone              String?            @db.VarChar(30)
  email              String?            @db.VarChar(255)
  address            String?            @db.VarChar(255)
  products           Product[]
  providerCategories ProviderCategory[]

  @@map("providers")
}

model OrderDetail {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  pickedQuantity Int      @default(0) @map("picked_quantity")
  quantity       Int
  unitPrice      Decimal  @map("unit_price") @db.Decimal(14, 2)
  subtotal       Decimal? @db.Decimal(14, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId], map: "idx_order_details_order")
  @@map("order_details")
}

model Despatch {
  id          String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId     String         @map("order_id") @db.Uuid
  shipDate    DateTime?      @default(now()) @map("ship_date")
  deliveredAt DateTime?      @map("delivered_at")
  status      DespatchStatus @default(in_transit)
  driverId    String?        @map("driver_id") @db.Uuid
  address     String?        @db.VarChar(500)

  order  Order @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driver User? @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId], map: "idx_despatches_order")
  @@map("despatches")
}

model InventoryMovement {
  requestKey  String?      @unique @map("request_key") @db.Uuid
  requestHash String?      @map("request_hash") @db.VarChar(64)
  id          String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId   String       @map("product_id") @db.Uuid
  type        MovementType
  quantity    Int
  reason      String?      @db.VarChar(500)
  userId      String?      @map("user_id") @db.Uuid
  date        DateTime?    @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User?   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([productId], map: "idx_inventory_movements_product")
  @@map("inventory_movements")
}

model Receipt {
  id            String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  receiptNumber Int           @unique @default(autoincrement()) @map("receipt_number")
  customerId    String?       @map("customer_id") @db.Uuid
  employeeId    String?       @map("employee_id") @db.Uuid
  orderId       String?       @unique @map("order_id") @db.Uuid
  date          DateTime?     @default(now())
  total         Decimal       @default(0) @db.Decimal(14, 2)
  paymentStatus ReceiptStatus @default(pending) @map("payment_status")

  receiptItems ReceiptItem[]
  customer     User?         @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee     User?         @relation("ReceiptEmployee", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payouts      Payout[]

  @@index([customerId], map: "idx_receipts_customer")
  @@index([employeeId], map: "idx_receipts_employee")
  @@index([orderId], map: "idx_receipts_order")
  @@map("receipts")
}

model Shopping {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  quantity  Int
  addedAt   DateTime? @default(now()) @map("added_at")

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, productId], map: "shopping_user_product_unique")
  @@index([userId], map: "idx_shopping_user")
  @@map("shopping")
}

model PromotionalCode {
  id          String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code        String              @unique @db.VarChar(50)
  description String?             @db.VarChar(500)
  type        PromotionalCodeType
  value       Decimal             @db.Decimal(14, 2)
  minPurchase Decimal?            @default(0) @map("min_purchase") @db.Decimal(14, 2)
  startDate   DateTime            @map("start_date") @db.Date
  endDate     DateTime            @map("end_date") @db.Date
  maxUses     Int?                @map("max_uses")
  currentUses Int?                @default(0) @map("current_uses")
  active      Boolean?            @default(true)
  version     Int                 @default(0)
  orders      Order[]

  @@map("promotional_codes")
}

model ReceiptItem {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  receiptId String   @map("receipt_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(14, 2)
  subtotal  Decimal? @db.Decimal(14, 2)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([receiptId], map: "idx_receipt_items_receipt")
  @@map("receipt_items")
}

model OrderReturn {
  id               String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  customerId       String       @map("customer_id") @db.Uuid
  productId        String       @map("product_id") @db.Uuid
  quantity         Int
  reason           String       @db.VarChar(500)
  status           ReturnStatus @default(requested)
  productCondition String       @default("good") @map("product_condition") @db.VarChar(30)
  refund           Decimal?     @default(0) @db.Decimal(14, 2)
  requestedAt      DateTime?    @default(now()) @map("requested_at")
  resolvedAt       DateTime?    @map("resolved_at")
  updatedAt        DateTime?    @default(now()) @map("updated_at")

  customer User    @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order    Order   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product  Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId], map: "idx_returns_order")
  @@map("returns")
}

model PqrRequest {
  id            String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  type          PqrType
  subject       String    @db.VarChar(160)
  description   String    @db.Text
  status        PqrStatus @default(received)
  response      String?   @db.Text
  respondedById String?   @map("responded_by_id") @db.Uuid
  respondedAt   DateTime? @map("responded_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  customer    User  @relation("PqrCustomer", fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  respondedBy User? @relation("PqrResponder", fields: [respondedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customerId, createdAt], map: "idx_pqr_customer_created")
  @@index([status, createdAt], map: "idx_pqr_status_created")
  @@map("pqr_requests")
}

model DeliveryAddress {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  contactName String?  @map("contact_name") @db.VarChar(150)
  phone       String?  @db.VarChar(30)
  address     String   @db.VarChar(255)
  city        String?  @db.VarChar(150)
  state       String?  @db.VarChar(150)
  isPrimary   Boolean? @default(false) @map("is_primary")

  user   User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders Order[]

  @@index([userId], map: "idx_delivery_addresses_user")
  @@map("delivery_addresses")
}

model PriceHistory {
  id            String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  previousPrice Decimal   @map("previous_price") @db.Decimal(14, 2)
  newPrice      Decimal   @map("new_price") @db.Decimal(14, 2)
  changedAt     DateTime? @default(now()) @map("changed_at")
  userId        String?   @map("user_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User?   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([productId], map: "idx_price_history_product")
  @@map("price_history")
}

model ProductImage {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar(500)
  name      String?  @db.VarChar(150)
  isPrimary Boolean? @default(false) @map("is_primary")
  sortOrder Int?     @default(1) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([productId], map: "idx_product_images_product")
  @@map("product_images")
}

model Wishlist {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  addedAt   DateTime? @default(now()) @map("added_at")

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, productId], map: "wishlist_user_product_unique")
  @@index([userId], map: "idx_wishlist_user")
  @@map("wishlist")
}

model Notification {
  id      String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId  String    @map("user_id") @db.Uuid
  title   String    @db.VarChar(150)
  message String    @db.VarChar(500)
  type    String    @db.VarChar(50)
  isRead  Boolean?  @default(false) @map("is_read")
  date    DateTime? @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "idx_notifications_user")
  @@map("notifications")
}

model Payout {
  id            String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  receiptId     String        @map("receipt_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  gateway       String        @db.VarChar(50)
  transactionId String        @unique @map("transaction_id") @db.VarChar(255)
  status        PaymentStatus @default(pending)
  method        String?       @db.VarChar(50)
  amount        Decimal       @db.Decimal(14, 2)
  currency      String        @default("COP") @db.VarChar(10)
  paidAt        DateTime?     @default(now()) @map("paid_at")
  confirmedAt   DateTime?     @map("confirmed_at")
  gatewayToken  String?       @map("gateway_token") @db.VarChar(255)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([receiptId], map: "idx_payouts_receipt")
  @@index([userId], map: "idx_payouts_user")
  @@map("payouts")
}

model Report {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  date            DateTime  @unique @db.Date
  totalOrders     Int       @default(0) @map("total_orders")
  deliveredOrders Int       @default(0) @map("delivered_orders")
  canceledOrders  Int       @default(0) @map("canceled_orders")
  totalSold       Decimal   @default(0) @map("total_sold") @db.Decimal(14, 2)
  totalPaid       Decimal   @default(0) @map("total_paid") @db.Decimal(14, 2)
  totalRefunded   Decimal   @default(0) @map("total_refunded") @db.Decimal(14, 2)
  productsSold    Int       @default(0) @map("products_sold")
  newCustomers    Int       @default(0) @map("new_customers")
  generatedAt     DateTime? @default(now()) @map("generated_at")

  @@index([date], map: "idx_reports_date")
  @@map("reports")
}

model Review {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  rating    Int
  comment   String?   @db.VarChar(1000)
  date      DateTime? @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([productId, userId], map: "review_product_user_unique")
  @@index([productId], map: "idx_reviews_product")
  @@map("reviews")
}

model ProviderCategory {
  providerId String @map("provider_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  category Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([providerId, categoryId], name: "provider_category_pkey")
  @@map("provider_categories")
}

model SecurityEvent {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  type      String   @db.VarChar(50)
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  detail    Json?
  success   Boolean  @default(true)
  date      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "idx_security_events_user")
  @@index([type, date], map: "idx_security_events_type_date")
  @@index([ip, date], map: "idx_security_events_ip_date")
  @@map("security_events")
}

model Combo {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  sku         String    @unique @db.VarChar(80)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  price       Decimal   @db.Decimal(14, 2)
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  items   ComboItem[]
  creator User?       @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([deletedAt], map: "idx_combos_deleted_at")
  @@map("combos")
}

model ComboItem {
  id        String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  comboId   String @map("combo_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity  Int

  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([comboId, productId], map: "combo_items_combo_product_unique")
  @@index([comboId], map: "idx_combo_items_combo")
  @@index([productId], map: "idx_combo_items_product")
  @@map("combo_items")
}

model OrderWork {
  id             String     @id @default(uuid()) @db.Uuid
  orderId        String     @unique @map("order_id") @db.Uuid
  assigneeId     String     @map("assignee_id") @db.Uuid
  status         WorkStatus @default(picking)
  claimedAt      DateTime   @default(now()) @map("claimed_at")
  packedAt       DateTime?  @map("packed_at")
  completedAt    DateTime?  @map("completed_at")
  pickupCodeHash String?    @map("pickup_code_hash") @db.VarChar(64)
  incident       String?    @db.VarChar(500)
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assignee       User       @relation("WorkAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)

  @@index([assigneeId, status])
  @@map("order_work")
}

model OrderEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   @db.VarChar(60)
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([actorId, createdAt])
  @@map("order_events")
}
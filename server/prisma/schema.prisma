generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model usuarios {
  id_usuario        Int       @id @default(autoincrement())
  nombre            String    @db.VarChar(100)
  email             String    @unique @db.VarChar(100)
  password          String    @db.VarChar(255)
  telefono          String?   @db.VarChar(20)
  direccion         String?   @db.VarChar(150)
  rol               String?   @default("cliente") @db.VarChar(20)
  envios            envios[]
  pedidos_cliente   pedidos[] @relation("PedidoCliente")
  pedidos_empleado  pedidos[] @relation("PedidoEmpleado")
}

model pedidos {
  id_pedido      Int              @id @default(autoincrement())
  id_cliente     Int?
  id_empleado    Int?
  fecha          DateTime?        @db.Date
  total          Decimal?         @db.Decimal(10, 2)
  detalle_pedido detalle_pedido[]
  envios         envios[]
  clientes       usuarios?        @relation("PedidoCliente", fields: [id_cliente], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  empleados      usuarios?        @relation("PedidoEmpleado", fields: [id_empleado], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  estado String? @default("Procesando") @db.VarChar(50)
}

model productos {
  id_producto            Int                      @id @default(autoincrement())
  nombre                 String                   @db.VarChar(100)
  descripcion            String?
  precio                 Decimal                  @db.Decimal(10, 2)
  id_categoria           Int?
  id_proveedor           Int?
  detalle_pedido         detalle_pedido[]
  inventario             inventario?
  movimientos_inventario movimientos_inventario[]
  categorias             categorias?              @relation(fields: [id_categoria], references: [id_categoria], onDelete: NoAction, onUpdate: NoAction)
  proveedores            proveedores?             @relation(fields: [id_proveedor], references: [id_proveedor], onDelete: NoAction, onUpdate: NoAction)
}

model categorias {
  id_categoria Int         @id @default(autoincrement())
  nombre       String      @db.VarChar(100)
  productos    productos[]
}

model proveedores {
  id_proveedor Int         @id @default(autoincrement())
  nombre       String      @db.VarChar(100)
  telefono     String?     @db.VarChar(20)
  email        String?     @db.VarChar(100)
  direccion    String?     @db.VarChar(150)
  contacto          String? @db.VarChar(100)
  productos_que_provee String? @db.VarChar(255)
  productos    productos[]
}

model inventario {
  id_inventario   Int        @id @default(autoincrement())
  id_producto     Int?       @unique
  cantidad_actual Int
  productos       productos? @relation(fields: [id_producto], references: [id_producto], onDelete: NoAction, onUpdate: NoAction)
}

model detalle_pedido {
  id_detalle      Int        @id @default(autoincrement())
  id_pedido       Int?
  id_producto     Int?
  cantidad        Int
  precio_unitario Decimal?   @db.Decimal(10, 2)
  pedidos         pedidos?   @relation(fields: [id_pedido], references: [id_pedido], onDelete: NoAction, onUpdate: NoAction)
  productos       productos? @relation(fields: [id_producto], references: [id_producto], onDelete: NoAction, onUpdate: NoAction)
}

model envios {
  id_envio      Int       @id @default(autoincrement())
  id_pedido     Int?
  id_repartidor Int?
  direccion     String?   @db.VarChar(150)
  estado        String?   @db.VarChar(50)
  pedidos       pedidos?  @relation(fields: [id_pedido], references: [id_pedido], onDelete: NoAction, onUpdate: NoAction)
  empleados     usuarios? @relation(fields: [id_repartidor], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

model movimientos_inventario {
  id_movimiento   Int        @id @default(autoincrement())
  id_producto     Int?
  tipo_movimiento String?    @db.VarChar(20)
  cantidad        Int
  fecha           DateTime?  @default(now()) @db.Timestamp(6)
  productos       productos? @relation(fields: [id_producto], references: [id_producto], onDelete: NoAction, onUpdate: NoAction)
}

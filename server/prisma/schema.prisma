generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model usuarios {
  id_usuario  Int       @id @default(autoincrement())
  nombre      String    @db.VarChar(100)
  email       String    @unique @db.VarChar(100)
  password    String    @db.VarChar(255)
  rol         String?   @default("cliente") @db.VarChar(20)
  id_cliente  Int?
  clientes    clientes? @relation(fields: [id_cliente], references: [id_cliente])
}

model clientes {
  id_cliente  Int        @id @default(autoincrement())
  nombre      String     @db.VarChar(100)
  telefono    String?    @db.VarChar(20)
  direccion   String?    @db.VarChar(150)
  email       String?    @db.VarChar(100)
  usuarios    usuarios[]
  pedidos     pedidos[]
}

model pedidos {
  id_pedido      Int                  @id @default(autoincrement())
  id_cliente     Int?
  id_empleado    Int?
  id_caja        Int?
  fecha          DateTime?            @db.Date
  total          Decimal?             @db.Decimal(10, 2)
  clientes       clientes?            @relation(fields: [id_cliente], references: [id_cliente])
  empleados      empleados?           @relation(fields: [id_empleado], references: [id_empleado])
  cajas          cajas_registradoras? @relation(fields: [id_caja], references: [id_caja])
  detalle_pedido detalle_pedido[]
  envios         envios[]
}

model productos {
  id_producto            Int                      @id @default(autoincrement())
  nombre                 String                   @db.VarChar(100)
  descripcion            String?
  precio                 Decimal                  @db.Decimal(10, 2)
  id_categoria           Int?
  id_proveedor           Int?
  categorias             categorias?              @relation(fields: [id_categoria], references: [id_categoria])
  proveedores            proveedores?             @relation(fields: [id_proveedor], references: [id_proveedor])
  inventario             inventario?
  detalle_pedido         detalle_pedido[]
  movimientos_inventario movimientos_inventario[]
}

model categorias {
  id_categoria Int         @id @default(autoincrement())
  nombre       String      @db.VarChar(100)
  productos    productos[]
}

model proveedores {
  id_proveedor Int         @id @default(autoincrement())
  nombre       String      @db.VarChar(100)
  telefono     String?     @db.VarChar(20)
  email        String?     @db.VarChar(100)
  direccion    String?     @db.VarChar(150)
  productos    productos[]
}

model inventario {
  id_inventario   Int        @id @default(autoincrement())
  id_producto     Int?       @unique
  cantidad_actual Int
  productos       productos? @relation(fields: [id_producto], references: [id_producto])
}

model detalle_pedido {
  id_detalle      Int        @id @default(autoincrement())
  id_pedido       Int?
  id_producto     Int?
  cantidad        Int
  precio_unitario Decimal?   @db.Decimal(10, 2)
  pedidos         pedidos?   @relation(fields: [id_pedido], references: [id_pedido])
  productos       productos? @relation(fields: [id_producto], references: [id_producto])
}

model envios {
  id_envio      Int        @id @default(autoincrement())
  id_pedido     Int?
  id_repartidor Int?
  direccion     String?    @db.VarChar(150)
  estado        String?    @db.VarChar(50)
  pedidos       pedidos?   @relation(fields: [id_pedido], references: [id_pedido])
  empleados     empleados? @relation(fields: [id_repartidor], references: [id_empleado])
}

model empleados {
  id_empleado Int                  @id @default(autoincrement())
  nombre      String               @db.VarChar(100)
  telefono    String?              @db.VarChar(20)
  email       String?              @db.VarChar(100)
  id_cargo    Int?
  id_caja     Int?
  cargos      cargos?              @relation(fields: [id_cargo], references: [id_cargo])
  cajas       cajas_registradoras? @relation(fields: [id_caja], references: [id_caja])
  pedidos     pedidos[]
  envios      envios[]
}

model cargos {
  id_cargo  Int         @id @default(autoincrement())
  nombre    String      @db.VarChar(50)
  empleados empleados[]
}

model cajas_registradoras {
  id_caja     Int         @id @default(autoincrement())
  numero_caja Int
  ubicacion   String?     @db.VarChar(100)
  estado      String?     @db.VarChar(20)
  empleados   empleados[]
  pedidos     pedidos[]
}

model movimientos_inventario {
  id_movimiento   Int        @id @default(autoincrement())
  id_producto     Int?
  tipo_movimiento String?    @db.VarChar(20)
  cantidad        Int
  fecha           DateTime?  @default(now())
  productos       productos? @relation(fields: [id_producto], references: [id_producto])
}
